[Unit]
Description=Mainline boot guard: confirm a good boot or fall back to the vendor kernel
ConditionKernelCommandLine=|vf2.trial=1
ConditionKernelCommandLine=|vf2.default=1
After=systemd-udev-settle.service
RequiresMountsFor=/boot

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/vf2-trial-guard 120

[Install]
WantedBy=multi-user.target
