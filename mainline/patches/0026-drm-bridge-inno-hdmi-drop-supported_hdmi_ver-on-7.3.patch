From 2f1fedf0508c38b75f5f767e12d023c1044f4b65 Mon Sep 17 00:00:00 2001
From: temidaradev <temidaradev@proton.me>
Date: Wed, 18 Nov 2026 23:45:41 +0300
Subject: [PATCH 26/27] drm/bridge: inno-hdmi: drop supported_hdmi_ver on 7.3

The DRM bridge supported_hdmi_ver field and enum hdmi_version only exist
from 7.4; 7.3 doesn't select the HDMI version, so remove it here.
---
 drivers/gpu/drm/bridge/jh7110-inno-hdmi.c | 1 -
 include/drm/bridge/inno_hdmi.h            | 1 -
 2 files changed, 2 deletions(-)

diff --git a/drivers/gpu/drm/bridge/jh7110-inno-hdmi.c b/drivers/gpu/drm/bridge/jh7110-inno-hdmi.c
index a0283f83d..3ce0add73 100644
--- a/drivers/gpu/drm/bridge/jh7110-inno-hdmi.c
+++ b/drivers/gpu/drm/bridge/jh7110-inno-hdmi.c
@@ -273,7 +273,6 @@ static const struct inno_hdmi_plat_ops stf_inno_hdmi_plat_ops = {
 static const struct inno_hdmi_plat_data stf_inno_hdmi_plat_data = {
 	.ops = &stf_inno_hdmi_plat_ops,
 	.reg_clk_source_tmds = true,
-	.supported_hdmi_ver = HDMI_VERSION_1_4,
 };
 
 static const struct of_device_id starfive_hdmi_controller_dt_ids[] = {
diff --git a/include/drm/bridge/inno_hdmi.h b/include/drm/bridge/inno_hdmi.h
index 89a38f260..3557f2eaf 100644
--- a/include/drm/bridge/inno_hdmi.h
+++ b/include/drm/bridge/inno_hdmi.h
@@ -36,7 +36,6 @@ struct inno_hdmi_plat_data {
 	/* Clock the register interface from the TMDS clock, not the system clock. */
 	bool reg_clk_source_tmds;
 	/* HDMI version the integration supports; HDMI 1.2 if left unset. */
-	enum hdmi_version supported_hdmi_ver;
 };
 
 struct inno_hdmi *inno_hdmi_bind(struct platform_device *pdev,
-- 
