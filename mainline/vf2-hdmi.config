# VisionFive 2 on mainline: merged over arch/riscv defconfig.
CONFIG_LOCALVERSION="-vf2"
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
# Live test-boots of later kernels without touching the boot config.
CONFIG_KEXEC=y
CONFIG_KEXEC_FILE=y
# Display built in, so boot messages appear on HDMI (no serial console needed).
CONFIG_DRM=y
CONFIG_DRM_VERISILICON_DC=y
CONFIG_DRM_STARFIVE_JH7110_INNO_HDMI=y
CONFIG_SOC_STARFIVE_JH7110_HDMI_SUBSYSTEM=y
CONFIG_SOC_STARFIVE_JH7110_VOUT_SUBSYSTEM=y
CONFIG_CLK_STARFIVE_JH7110_VOUT=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# Root on the SD card without an initramfs.
CONFIG_MMC_DW=y
CONFIG_MMC_DW_STARFIVE=y
CONFIG_EXT4_FS=y
# Ethernet built in so the board is reachable over SSH even if modules fail.
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_DWMAC_STARFIVE=y
CONFIG_MOTORCOMM_PHY=y
# USB ports sit behind the PCIe VL805 xHCI controller.
CONFIG_PCIE_STARFIVE_HOST=y
CONFIG_PHY_STARFIVE_JH7110_PCIE=y
CONFIG_PHY_STARFIVE_JH7110_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_HID=y
CONFIG_HID_GENERIC=y
# Swap file and desktop tuning in use on the board.
CONFIG_SWAP=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
# PowerVR GPU: StarFive's vendor driver (img-rogue), not the open drm/imagination one.
# CONFIG_DRM_POWERVR is not set
CONFIG_DRM_IMG=y
CONFIG_DRM_IMG_ROGUE=m
# The vendor driver predates newer compiler warnings.
# CONFIG_WERROR is not set
CONFIG_PM=y
# HDMI PHY (separate jh7110-inno-hdmi-phy series).
CONFIG_PHY_STARFIVE_JH7110_INNO_HDMI=y
# qemu-user binfmt registrations (Claude Code, Codex code mode).
CONFIG_BINFMT_MISC=y
# Hardware watchdog: during a one-shot trial boot, a hang resets the board back to 6.12.
CONFIG_WATCHDOG=y
CONFIG_STARFIVE_WATCHDOG=y
# The display DT reserves a 512 MB "linux,cma" region; without CMA the DC8200 can't
# allocate scanout buffers (fbdev: ret=-12) and the screen stays black.
CONFIG_CMA=y
CONFIG_DMA_CMA=y
# --- Desktop tuning (CPU-rendered desktop on 4x U74) ---
# Full preemption: input and compositor stay responsive while the CPU renders.
CONFIG_PREEMPT=y
# schedutil ramps the cores up immediately on load (OPP table is in the mainline DT).
CONFIG_CPU_FREQ=y
CONFIG_CPUFREQ_DT=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
# Compressed swap in RAM instead of swapping to the SD card.
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
# Multi-gen LRU reclaims memory with far fewer stalls under pressure.
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
# Huge pages only where applications ask for them.
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
